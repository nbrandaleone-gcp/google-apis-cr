    <%- if method.description -%>
    # <%= method.description.not_nil!.gsub("\n", "\n    # ") %>
    <%- end -%>
  <%- if has_args -%>
    def <%= method.crystal_name %>(
    <%- method.required_parameters.each do |param| -%>
      <%= param.crystal_name %> : <%= param.crystal_type %>,
    <%- end -%>
    <%- if method.request_ref -%>
      body : <%= method.request_ref %>? = nil,
    <%- end -%>
    <%- method.optional_parameters.each do |param| -%>
      <%= param.crystal_name %> : <%= param.crystal_type %>? = nil,
    <%- end -%>
    ) : <%= method.response_ref || "Nil" %>
  <%- else -%>
    def <%= method.crystal_name %> : <%= method.response_ref || "Nil" %>
