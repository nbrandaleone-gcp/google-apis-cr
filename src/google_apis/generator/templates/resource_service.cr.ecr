      req_path = "<%= method.path %>"
  <%- method.path_parameters.each do |param| -%>
      req_path = req_path.gsub("{<%= param.json_name %>}", URI.encode_path_segment(<%= param.crystal_name %>.to_s))
      req_path = req_path.gsub("{+<%= param.json_name %>}", <%= param.crystal_name %>.to_s.split('/').map { |segment| URI.encode_path_segment(segment) }.join('/'))
  <%- end -%>

      params = Hash(String, String | Array(String) | Int32 | Int64 | Bool | Nil).new
  <%- method.query_parameters.select(&.required?).each do |param| -%>
      params["<%= param.json_name %>"] = <%= param.crystal_name %>
  <%- end -%>
  <%- method.query_parameters.reject(&.required?).each do |param| -%>
      params["<%= param.json_name %>"] = <%= param.crystal_name %> unless <%= param.crystal_name %>.nil?
  <%- end -%>

  <%- if method.response_ref -%>
      @client.execute(
        type: <%= method.response_ref %>,
        http_method: "<%= method.http_method %>",
