<%- end -%>

module <%= @service.module_name %>
  # Client for the <%= @service.title || @service.name %> API (<%= @service.version %>).
  class Client
    DEFAULT_BASE_URL = "<%= @service.base_url %>"

    getter client : GoogleApis::Client
<%- @service.resources.each do |resource| -%>
